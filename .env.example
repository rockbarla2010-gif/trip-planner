# Copy this file to .env and fill in your key, or set the variable in your shell.
# Without a key the app still runs in --demo mode (deterministic stub pipeline, no LLM).
ANTHROPIC_API_KEY=

# Optional overrides
# ANTHROPIC_MODEL=claude-sonnet-5
# SUBAGENT_MODEL=claude-sonnet-5
# LOG_DIR=logs

# --- Amadeus APIs (real flights, hotels & attractions) ---------------------
# Get free self-service test credentials at https://developers.amadeus.com
# When both are set, searchFlights/searchHotels/searchAttractions use live APIs.
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
# Base host: test.api.amadeus.com (default) or api.amadeus.com for production keys
# AMADEUS_BASE_URL=https://test.api.amadeus.com
# AMADEUS_FALLBACK=1        # 1 (default) = fall back to stub on error; 0 = return the error
# AMADEUS_DISABLE=1         # force the stub even when credentials are present
# AMADEUS_TIMEOUT_MS=15000
# CLUSTER_RADIUS_KM=1.8     # attraction geo-clustering radius
# AMADEUS_HOTEL_CANDIDATES=20  # closest hotels to price per search

# --- Google Places API (real restaurants) ----------------------------------
# Enable "Places API (New)" in Google Cloud and create an API key.
# When set, searchRestaurants() uses live Google Places instead of the stub.
GOOGLE_PLACES_API_KEY=
# GOOGLE_MAPS_API_KEY=       # accepted as an alternative name
# GOOGLE_FALLBACK=1          # 1 (default) = fall back to stub on error; 0 = return the error
# GOOGLE_DISABLE=1           # force the stub even when a key is present
# GOOGLE_PLACES_RADIUS_M=1500  # location-bias radius around each cluster centroid
# GOOGLE_TIMEOUT_MS=12000
